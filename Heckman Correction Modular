import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy.stats import norm

class HeckmanTwoStage:
    """
    A modular two-step Heckman correction wrapper.

    Parameters
    ----------
    outcome_estimator : object
        Any estimator with .fit(X, y) and .predict or .predict_proba.
    use_proba : bool
        If True, wrapper.predict returns outcome_estimator.predict_proba.
    add_constant : bool
        Whether to add a constant to both selection and outcome features.
    """
    def __init__(self, outcome_estimator, use_proba=True, add_constant=True):
        self.outcome_estimator = outcome_estimator
        self.use_proba = use_proba
        self.add_constant = add_constant
        self.selection_model_ = None
        self.outcome_model_ = None

    def _prepare(self, X, add_const):
        Xp = X.copy()
        if self.add_constant and add_const:
            Xp = sm.add_constant(Xp, has_constant='add')
        return Xp.values

    def fit(self, X_select, y_select, X_outcome, y_outcome):  # noqa: D417
        """
        Fit the two-step model.

        X_select : DataFrame
            Features for selection equation (full sample).
        y_select : array-like
            1 if observed (originated), 0 otherwise.
        X_outcome : DataFrame
            Features for outcome equation (originated only).
        y_outcome : array-like
            Observed outcome (default) for originated loans.
        """
        # 1. Fit Probit selection
        Z = self._prepare(X_select, add_const=True)
        probit = sm.Probit(y_select, Z)
        self.selection_model_ = probit.fit(disp=False)
        z_index = self.selection_model_.fittedvalues  # latent index

        # 2. Compute IMR for all
        pdf = norm.pdf(z_index)
        cdf = norm.cdf(z_index)
        imr = pdf / np.clip(cdf, 1e-8, None)

        # 3. Fit outcome with IMR as extra feature
        mask = (y_select == 1)
        X1 = self._prepare(X_outcome, add_const=False)
        imr1 = imr[mask]
        W = np.hstack([X1, imr1[:, None]])
        self.outcome_model_ = self.outcome_estimator.fit(W, y_outcome)
        return self

    def predict(self, X_select_new, X_outcome_new):  # noqa: D417
        """
        Predict using the two-stage model.

        X_select_new : DataFrame
            Features for selection equation.
        X_outcome_new : DataFrame
            Features for outcome equation.

        Returns
        -------
        array
            Predictions (or probabilities) of the outcome.
        """
        # Compute new IMR
        Z_new = self._prepare(X_select_new, add_const=True)
        zindex_new = Z_new.dot(self.selection_model_.params)
        pdf_new = norm.pdf(zindex_new)
        cdf_new = norm.cdf(zindex_new)
        imr_new = pdf_new / np.clip(cdf_new, 1e-8, None)

        # Combine with outcome features
        X2 = self._prepare(X_outcome_new, add_const=False)
        W_new = np.hstack([X2, imr_new[:, None]])

        # Return desired prediction
        if self.use_proba and hasattr(self.outcome_model_, 'predict_proba'):
            return self.outcome_model_.predict_proba(W_new)
        return self.outcome_model_.predict(W_new)

