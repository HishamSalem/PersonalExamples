class HeckmanWrapper:
    """Modular two–stage Heckman correction that plugs any sklearn‑like estimator.

    Parameters
    ----------
    estimator : object
        Must implement ``fit(X, y)`` and ``predict`` (and optionally
        ``predict_proba``).  E.g. ``xgboost.XGBClassifier``.
    method : {'twostep', 'mle'}, default 'twostep'
        Which routine of the original `Heckman` class to call.
    add_constant : bool, default True
        Whether to prepend a constant column to both *selection* and *outcome*
        feature blocks (mirrors `statsmodels.add_constant`).
    clip : float, default 1e-8
        Lower bound on Φ(.) in IMR to avoid divide‑by‑zero.
    """

    def __init__(self, estimator, *, method="twostep", add_constant=True, clip=1e-8):
        self.base_estimator = estimator
        self.method = method
        self.add_constant = add_constant
        self.clip = clip

        # Filled during fit
        self.heckman_res_ = None  # statsmodels results
        self.estimator_ = None    # fitted outcome estimator


    def _const(self, X):
        """Optionally add a constant & return numpy array."""
        if self.add_constant:
            return sm.add_constant(X, has_constant="add").values
        return np.asarray(X)

    def _imr(self, Zidx):
        """ϕ/Φ with clipping to keep finite."""
        pdf = norm.pdf(Zidx)
        cdf = np.clip(norm.cdf(Zidx), self.clip, 1.0)
        return pdf / cdf


    def fit(self, X_select, y_select, X_outcome, y_outcome):
        """Fit wrapper.

        Parameters
        ----------
        X_select : DataFrame/array‑like, shape (n_samples, n_Z)
            Features used in the *selection* equation (whole population).
        y_select : array‑like, shape (n_samples,)
            1 ⇒ originated (un‑censored), 0 ⇒ rejected.
        X_outcome : DataFrame/array‑like, shape (n_originated, n_X)
            Outcome‑equation features for *originated* subsample.
        y_outcome : array‑like, shape (n_originated,)
            Observed target (e.g. default) for originated loans.
        """
        # 1️⃣ Build the unified inputs expected by the original Heckman class
        X_sel_const = self._const(X_select)
        X_out_const = self._const(X_outcome)

        mask_originated = (y_select == 1)
        if np.sum(mask_originated) != len(y_outcome):
            raise ValueError("y_outcome length must equal number of 1's in y_select")

        # endog = y_outcome with NaN where censored
        endog = np.full_like(y_select, np.nan, dtype=float)
        endog[mask_originated] = y_outcome

        # The original Heckman wants X for *all* rows, but rows w/ NaN outcome
        # are ignored in step‑2 internally. We duplicate outcome‑feature block
        # for censored rows just to satisfy the API.
        X_block = np.zeros((len(y_select), X_out_const.shape[1]))
        X_block[mask_originated] = X_out_const

        # 2️⃣ Fit the statsmodels Heckman
        model = Heckman(endog, X_block, X_sel_const, missing="none")
        self.heckman_res_ = model.fit(method=self.method)

        # 3️⃣ Compute IMR for *all* rows
        zidx = self.heckman_res_.select_res.fittedvalues
        imr_all = self._imr(zidx)

        # 4️⃣ Fit user estimator on originated loans + IMR
        W = np.hstack([X_out_const, imr_all[mask_originated][:, None]])
        self.estimator_ = self.base_estimator.fit(W, y_outcome)
        return self

    def predict(self, X_select_new, X_outcome_new, *, proba=False):
        """Predict with corrected model.

        X_select_new : features for selection equation
        X_outcome_new : features for outcome equation
        proba : bool, default False -> call predict_proba if available
        """
        if self.heckman_res_ is None:
            raise ValueError("Must call fit before predict.")

        # Compute IMR from stored Probit coefficients
        Z_new = self._const(X_select_new)
        zidx_new = Z_new @ self.heckman_res_.select_res.params
        imr_new = self._imr(zidx_new)[:, None]

        X_out_const = self._const(X_outcome_new)
        W_new = np.hstack([X_out_const, imr_new])

        if proba and hasattr(self.estimator_, "predict_proba"):
            return self.estimator_.predict_proba(W_new)
        return self.estimator_.predict(W_new)
